{
  "schemaVersion": 1,
  "id": "ambitiousrealism.t3-loupe",
  "name": "T3 Loupe",
  "version": "2.5.4",
  "author": "ambitiousrealism",
  "license": "MIT",
  "description": "Live, read-only T3 Code thread monitor: activity ring, attention alerts, per-thread activity, usage limits.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "T3 Loupe",
    "description": "Live T3 Code thread activity across paired machines.",
    "category": "Development",
    "aliases": [
      "loupe",
      "t3",
      "t3code",
      "threads",
      "agents"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "display": "label",
      "reduceMotion": false,
      "panelWidth": 540,
      "presentation": "centered"
    },
    "schema": [
      {
        "key": "display",
        "type": "enum",
        "label": "Bar display",
        "options": [
          "label",
          "ring",
          "ring-count"
        ],
        "defaultValue": "label"
      },
      {
        "key": "presentation",
        "type": "enum",
        "label": "Panel layout",
        "options": [
          "centered",
          "dropdown"
        ],
        "defaultValue": "centered",
        "description": "centered: floating two-pane window (list + live detail). dropdown: compact panel under the bar. Press f in the panel to switch."
      },
      {
        "key": "reduceMotion",
        "type": "boolean",
        "label": "Reduce motion",
        "defaultValue": false
      },
      {
        "key": "panelWidth",
        "type": "integer",
        "label": "Panel width",
        "min": 420,
        "max": 900,
        "step": 20,
        "defaultValue": 540
      }
    ]
  }
}
