#!/bin/bash
# Bring the running T3 Code window forward through Hyprland.
#
# Matches the window *class* only (com.t3tools.T3Code, t3code, t3code-dev …), never the
# title, so a browser tab named "t3code" can't steal focus. Does not rely on the
# t3code:// URL handler, which can point at a stale build and which T3 only uses to
# raise its window anyway.
set -u
addr=$(hyprctl clients -j 2>/dev/null \
  | jq -r '[.[] | select(.class | test("(^|\\.)t3code($|-)"; "i"))] | sort_by(.focusHistoryID) | .[0].address // empty')
if [[ -n $addr ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
  exit 0
fi
omarchy-notification-send --app-name "T3 Loupe" -g "󰚩" "T3 Code is not running" "Start T3 Code, then press o again." >/dev/null 2>&1
exit 1
